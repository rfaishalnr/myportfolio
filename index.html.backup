  <script src="assets/vendor/waypoints/noframework.waypoints.js"></script>
  <script src="assets/vendor/php-email-form/validate.js"></script>

  <!-- Template Main JS File -->
  <script src="assets/js/main.js"></script>

  <!-- Custom SPA Navigation Script -->
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // Menangani klik pada tombol "Tentang Saya" agar lebih mulus
      const btnTentangSaya = document.querySelector('a.hero-btn[href="#about"]');
      if (btnTentangSaya) {
        btnTentangSaya.addEventListener('click', function (e) {
          e.preventDefault();
          const target = document.querySelector('#about');
          if (target) {
            window.scrollTo({
              top: target.offsetTop,
              behavior: 'smooth'
            });
          }
        });
      }

      // Add click event to portfolio links (both navbar and hero button)
      const portfolioTriggers = [document.getElementById('portfolio-link'), document.getElementById('hero-btn-portfolio')];

      portfolioTriggers.forEach(trigger => {
        if (trigger) {
          trigger.addEventListener('click', function (e) {
            e.preventDefault();
            showPortfolioContent();
          });
        }
      });

      // Add click events to navigation links to ensure proper navigation
      document.querySelectorAll('.nav-link').forEach(link => {
        link.addEventListener('click', function (e) {
          if (document.getElementById('portfolio-content').style.display === 'block' &&
            this.id !== 'portfolio-link') {
            e.preventDefault();
            backToHome(this.id);

            // After returning to home, scroll to appropriate section
            const targetId = this.getAttribute('href');
            if (targetId && targetId !== '#') {
              setTimeout(() => {
                const targetElement = document.querySelector(targetId);
                if (targetElement) {
                  window.scrollTo({
                    top: targetElement.offsetTop,
                    behavior: 'smooth'
                  });
                }
              }, 100);
            }
          }
        });
      });

      // Initialize zoom modal functionality
      setupZoomModal();
    });

    function showPortfolioContent() {
      // Hide home content and show portfolio content
      document.getElementById('home-content').style.display = 'none';
      document.getElementById('portfolio-content').style.display = 'block';

      // Update active nav link
      document.querySelectorAll('.nav-link').forEach(link => {
        link.classList.remove('active');
      });
      document.getElementById('portfolio-link').classList.add('active');

      // Scroll to top when showing portfolio
      window.scrollTo({ top: 0, behavior: 'smooth' });

      // Close mobile navbar if active
      let body = document.querySelector("body");
      let navbarToggle = document.querySelector(".mobile-nav-toggle");
      if (body.classList.contains("mobile-nav-active")) {
        body.classList.remove("mobile-nav-active");
        navbarToggle.classList.toggle("bi-list");
        navbarToggle.classList.toggle("bi-x");
      }
    }

    function backToHome(activeLinkId) {
      // Hide portfolio content and show home content
      document.getElementById('portfolio-content').style.display = 'none';
      document.getElementById('home-content').style.display = 'block';

      // Update active nav link
      document.querySelectorAll('.nav-link').forEach(link => {
        link.classList.remove('active');
      });
      if (activeLinkId) {
        document.getElementById(activeLinkId).classList.add('active');
      } else {
        document.getElementById('home-link').classList.add('active');
      }

      // Scroll to top when returning to home
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Zoom Modal Functions
    function setupZoomModal() {
      const modal = document.getElementById('zoomModal');
      modal.addEventListener('click', function (e) {
        if (e.target === modal) {
          closeZoom();
        }
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && modal.style.display === 'block') {
          closeZoom();
        }
      });
    }

    function openZoom(imgSrc, caption) {
      const modal = document.getElementById('zoomModal');
      const modalImg = document.getElementById('zoomImage');
      const captionText = document.getElementById('captionText');
      modal.style.display = 'block';
      modalImg.src = imgSrc;
      captionText.innerHTML = caption;
    }

    function closeZoom() {
      document.getElementById('zoomModal').style.display = 'none';
    }
  </script>
</body>

</html>