    <!-- Portfolio content section -->
    <div id="portfolio-content" class="fade-in">
      <div class="container mt-5">

        <!-- Header Portofolio (Diperbarui dengan gradien modern) -->
        <header class="portfolio-header shadow-sm mb-5 position-relative overflow-hidden"
          style="border-radius: 20px; background: linear-gradient(135deg, #0563bb 0%, #0099ff 100%); padding: 50px 20px;">
          <h1 class="fade-in text-white mb-2"
            style="font-family: 'Poppins', sans-serif; font-weight: 700; letter-spacing: 1px;">PORTFOLIO</h1>
          <p class="fade-in text-white-50 mb-0" style="font-size: 1.05rem;">Kumpulan hasil karya, website, dan aplikasi
            yang telah saya kembangkan.</p>
        </header>

        <section class="py-4">
          <div class="row gy-5 align-items-stretch">

            <!-- Project 1: PATA -->
            <div class="col-lg-4 col-md-6 d-flex align-items-stretch">
              <div class="portfolio-item fade-in w-100 bg-white shadow-sm d-flex flex-column"
                style="animation-delay: 0.1s; border-radius: 15px; border: 1px solid #f0f0f0;">
                <div class="portfolio-image-container position-relative"
                  style="border-radius: 15px 15px 0 0; overflow: hidden;">
                  <img src="assets/img/portfolio/pataweb.png" alt="PATA Website" class="portfolio-image w-100"
                    style="height: 220px; object-fit: cover;"
                    onclick="openZoom(this.src, 'PATA (Pengelolaan Tagihan Mitra)')">
                </div>
                <div class="portfolio-description p-4 d-flex flex-column flex-grow-1">
                  <h4 style="color: #0563bb; font-weight: 700; font-size: 1.15rem; margin-bottom: 12px;">PATA
                    (Pengelolaan Tagihan Mitra)</h4>
                  <p style="color: #6c757d; font-size: 0.9rem; line-height: 1.6;">Sistem manajemen tagihan mitra
                    berbasis web yang dikembangkan untuk PT Telkom Akses guna meminimalkan kesalahan dokumen tagihan.
                    Dilengkapi formulir dinamis dan aturan validasi.</p>

                  <!-- Modern Tags -->
                  <div class="mb-4 mt-2">
                    <span
                      style="display: inline-block; background-color: #e6f0fa; color: #0563bb; padding: 5px 14px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; margin: 0 5px 8px 0;">Laravel</span>
                    <span
                      style="display: inline-block; background-color: #e6f0fa; color: #0563bb; padding: 5px 14px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; margin: 0 5px 8px 0;">PHP</span>
                    <span
                      style="display: inline-block; background-color: #e6f0fa; color: #0563bb; padding: 5px 14px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; margin: 0 5px 8px 0;">MySQL</span>
                  </div>

                  <!-- Modern Full-width Button -->
                  <div class="mt-auto pt-3" style="border-top: 1px solid #f0f0f0;">
                    <a href="https://github.com/rfaishalnr/website-pengelolaan-tagihan-mitra" target="_blank"
                      class="d-flex align-items-center justify-content-center"
                      style="background-color: transparent; border: 2px solid #0563bb; color: #0563bb; padding: 10px; border-radius: 50px; text-decoration: none; font-weight: 600; font-size: 0.9rem; transition: all 0.3s ease;"
                      onmouseover="this.style.backgroundColor='#0563bb'; this.style.color='white';"
                      onmouseout="this.style.backgroundColor='transparent'; this.style.color='#0563bb';">
                      <i class="bx bxl-github fs-5" style="margin-right: 8px;"></i> Lihat GitHub
                    </a>
                  </div>
                </div>
              </div>
            </div>

            <!-- Project 2: PesanMakan -->
            <div class="col-lg-4 col-md-6 d-flex align-items-stretch">
              <div class="portfolio-item fade-in w-100 bg-white shadow-sm d-flex flex-column"
                style="animation-delay: 0.2s; border-radius: 15px; border: 1px solid #f0f0f0;">
                <div class="portfolio-image-container position-relative"
                  style="border-radius: 15px 15px 0 0; overflow: hidden;">
                  <img src="assets/img/portfolio/pesanmakanweb.png" alt="PesanMakan SaaS" class="portfolio-image w-100"
                    style="height: 220px; object-fit: cover;" onclick="openZoom(this.src, 'PesanMakan - SaaS E-Menu')">
                </div>
                <div class="portfolio-description p-4 d-flex flex-column flex-grow-1">
                  <h4 style="color: #0563bb; font-weight: 700; font-size: 1.15rem; margin-bottom: 12px;">PesanMakan
                    (SaaS Digital Menu & POS)</h4>
                  <p style="color: #6c757d; font-size: 0.9rem; line-height: 1.6;">Pengembangan aplikasi SaaS
                    multi-tenant untuk manajemen restoran. Terintegrasi dengan pemesanan QR Code, pelacakan status
                    real-time, sistem langganan, dan payment gateway Midtrans.</p>

                  <!-- Modern Tags -->
                  <div class="mb-4 mt-2">
                    <span
                      style="display: inline-block; background-color: #e6f0fa; color: #0563bb; padding: 5px 14px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; margin: 0 5px 8px 0;">Laravel
                      12</span>
                    <span
                      style="display: inline-block; background-color: #e6f0fa; color: #0563bb; padding: 5px 14px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; margin: 0 5px 8px 0;">Tailwind
                      CSS</span>
                  </div>

                  <!-- Modern Full-width Button -->
                  <div class="mt-auto pt-3" style="border-top: 1px solid #f0f0f0;">
                    <a href="https://github.com/rfaishalnr/PesanMakan---Multi-Tenant-Digital-Menu-Cashier-System"
                      target="_blank" class="d-flex align-items-center justify-content-center"
                      style="background-color: transparent; border: 2px solid #0563bb; color: #0563bb; padding: 10px; border-radius: 50px; text-decoration: none; font-weight: 600; font-size: 0.9rem; transition: all 0.3s ease;"
                      onmouseover="this.style.backgroundColor='#0563bb'; this.style.color='white';"
                      onmouseout="this.style.backgroundColor='transparent'; this.style.color='#0563bb';">
                      <i class="bx bxl-github fs-5" style="margin-right: 8px;"></i> Lihat GitHub
                    </a>
                  </div>
                </div>
              </div>
            </div>

            <!-- Project 3: Desa Wisata Cigalontang -->
            <div class="col-lg-4 col-md-6 d-flex align-items-stretch">
              <div class="portfolio-item fade-in w-100 bg-white shadow-sm d-flex flex-column"
                style="animation-delay: 0.3s; border-radius: 15px; border: 1px solid #f0f0f0;">
                <div class="portfolio-image-container position-relative"
                  style="border-radius: 15px 15px 0 0; overflow: hidden;">
                  <img src="assets/img/portfolio/webcigalontang.png" alt="Profil Desa Cigalontang"
                    class="portfolio-image w-100" style="height: 220px; object-fit: cover;"
                    onclick="openZoom(this.src, 'Profil Desa Cigalontang')">
                </div>
                <div class="portfolio-description p-4 d-flex flex-column flex-grow-1">
                  <h4 style="color: #0563bb; font-weight: 700; font-size: 1.15rem; margin-bottom: 12px;">Profil Desa
                    Wisata Cigalontang</h4>
                  <p style="color: #6c757d; font-size: 0.9rem; line-height: 1.6;">Pengembangan website informasi publik
                    dan promosi wisata desa (sejarah, UMKM, paket wisata) interaktif. Proyek ini dibangun sebagai
                    kontribusi digital program KKN.</p>

                  <!-- Modern Tags -->
                  <div class="mb-4 mt-2">
                    <span
